# =============================================================================
# TriDomainMoE — Environment Configuration Template
# Copy this file to '.env' and populate with your credentials.
# NEVER commit your actual '.env' file to public version control.
# =============================================================================

# MetaTrader 5 Connection Settings (Optional - leave empty for active desktop terminal)
MT5_LOGIN=YOUR_ACCOUNT_LOGIN
MT5_PASSWORD=YOUR_ACCOUNT_PASSWORD
MT5_SERVER=YOUR_BROKER_SERVER
MT5_PATH=

# Telemetry & Logging
TRADER_LOG_DIR=logs
DASHBOARD_PORT=8888

# Hugging Face Hub (Optional - for pushing model checkpoints)
HUGGINGFACE_TOKEN=your_hf_token_here
HUGGINGFACE_REPO=tri-domain-moe/btcusd-tri-domain-v2
